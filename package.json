{
  "name": "aesthetic-dna",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs && node tests/bilingual.e2e.mjs && node tests/photo-personal.e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "Discover your visual point of view through cinema, color and hands-on design experiments.",
  "engines": {
    "node": ">=22.18.0"
  }
}
